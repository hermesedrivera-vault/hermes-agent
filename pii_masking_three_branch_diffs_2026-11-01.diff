+        "EIN format regex accepts a valid fake EIN",
+        lambda: None if _EIN_RE.fullmatch(FAKE_EIN_DASHED) else (_ for _ in ()).throw(ValueError("should match")),
+    ))
+
+    # --- fill_form() redaction-marker guard ---
+    results.append(check(
