+import datetime as dt
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent / "engine" / "src"))
+
+from jnc_engine.model import Person, ScheduleC  # noqa: E402
+from jnc_engine.render.pdf import _refuse_redaction_markers  # noqa: E402
+
+FAKE_SSN_DASHED = "123-45-6789"
+FAKE_SSN_BARE = "123456789"
+FAKE_EIN_DASHED = "12-3456789"
+MARKER = "[SSN-REDACTED]"
+
+
+def check(label, fn):
+    try:
+        fn()
+        print(f"FAIL | {label} | expected an exception, none raised")
+        return False
+    except ValueError as e:
+        print(f"OK   | {label} | raised ValueError: {e}")
+        return True
+    except Exception as e:  # noqa: BLE001
+        print(f"FAIL | {label} | wrong exception type {type(e).__name__}: {e}")
+        return False
+
+
+def check_ok(label, fn):
+    try:
+        fn()
+        print(f"OK   | {label} | no exception (as expected)")
+        return True
+    except Exception as e:  # noqa: BLE001
+        print(f"FAIL | {label} | unexpected exception {type(e).__name__}: {e}")
+        return False
+
+
+def main():
+    results = []
+
+    # --- Person.ssn format validation at construction ---
+    results.append(check(
+        "Person.ssn rejects a redaction marker at construction",
+        lambda: Person(name="Test Fake", date_of_birth=dt.date(1980, 1, 1), ssn=MARKER),
+    ))
+    results.append(check(
+        "Person.ssn rejects a malformed value (too few digits)",
+        lambda: Person(name="Test Fake", date_of_birth=dt.date(1980, 1, 1), ssn="12-34-5678"),
+    ))
+    results.append(check(
+        "Person.ssn rejects a malformed value (letters)",
+        lambda: Person(name="Test Fake", date_of_birth=dt.date(1980, 1, 1), ssn="ABC-DE-FGHI"),
+    ))
+    results.append(check_ok(
+        "Person.ssn accepts a valid fake SSN, dashed",
+        lambda: Person(name="Test Fake", date_of_birth=dt.date(1980, 1, 1), ssn=FAKE_SSN_DASHED),
+    ))
+    results.append(check_ok(
+        "Person.ssn accepts a valid fake SSN, bare digits",
+        lambda: Person(name="Test Fake", date_of_birth=dt.date(1980, 1, 1), ssn=FAKE_SSN_BARE),
+    ))
+    results.append(check_ok(
+        "Person.ssn accepts None (optional field)",
+        lambda: Person(name="Test Fake", date_of_birth=dt.date(1980, 1, 1)),
+    ))
+
