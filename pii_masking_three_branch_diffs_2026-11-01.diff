+"""SSN/ITIN/EIN pattern masking applied to chunk text before embedding.
+
+Kept deliberately standalone (stdlib `re` only) so it has no dependency on the
+hermes-agent package (separate process/venv). Mirrors the same two regex passes
+added to hermes-agent's agent/redact.py on 2026-11-01 -- keep both in sync if the
+pattern or scope ever changes (Ed, SSN/backup remediation item (b)).
+
+Scope: SSN/ITIN share the ###-##-#### shape and are always masked. EIN (##-#######)
+is only masked when a tax-ID keyword ("EIN"/"employer identification"/"tax ID")
+appears within 80 chars of the match -- the bare EIN shape alone has too many false
+positives (invoice numbers, version strings, etc.), confirmed during the 2026-11-01
+vault/ChromaDB/state.db SSN inventory.
+"""
+import re
+
+_SSN_ITIN_RE = re.compile(r"(?<!\d)\d{3}-\d{2}-\d{4}(?!\d)")
+_EIN_RE = re.compile(r"(?<!\d)\d{2}-\d{7}(?!\d)")
+_EIN_KEYWORD_RE = re.compile(r"\bEIN\b|employer\s+identification|tax\s*[-\s]?id", re.IGNORECASE)
+_EIN_CONTEXT_WINDOW = 80
+
+
+def scrub_pii(text: str) -> str:
+    """Mask SSN/ITIN/EIN-shaped text in `text`. Call before a chunk is embedded/stored."""
+    if "-" not in text:
+        return text
+    text = _SSN_ITIN_RE.sub("[SSN-REDACTED]", text)
+    if _EIN_RE.search(text) and _EIN_KEYWORD_RE.search(text):
+        def _mask_ein(m: "re.Match[str]") -> str:
+            start = max(0, m.start() - _EIN_CONTEXT_WINDOW)
+            end = min(len(text), m.end() + _EIN_CONTEXT_WINDOW)
+            if _EIN_KEYWORD_RE.search(text[start:end]):
+                return "[EIN-REDACTED]"
+            return m.group(0)
+        text = _EIN_RE.sub(_mask_ein, text)
+    return text
